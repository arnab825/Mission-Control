# ── Distributed Library Server Multi-Cloud Environment ────────────────────────
# Copy to .env and fill in your connection strings.

# ── Tier 1: Primary Cloud Database (Supabase PostgreSQL) ──────────────────────
# Keeps 83.4k+ games master catalog, full-text search, and auth. Kept awake 24/7 via Vercel Cron.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.vekqkwwzzamwhitjodld.supabase.co:5432/postgres?sslmode=require
SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.vekqkwwzzamwhitjodld.supabase.co:5432/postgres?sslmode=require

# ── Tier 2: Hot Standby Fallback Database (Neon Serverless PostgreSQL) ────────
# 100% Free (No credit card, sign up with GitHub/Google at https://neon.tech)
FALLBACK_DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-standby-pool.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-standby-pool.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Tier 3: Local NVMe SQLite Replica (catalog_fallback.db) ───────────────────
# Automatically initialized and synced locally. Zero network dependency.

# ── Tier 4: Document Mirror (MongoDB Atlas Free M0) ───────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority

# ── Redis Cache Layer (Optional) ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── AI Providers for Metadata Enrichment & Auto-Classification ────────────────
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE
GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# ── Web Metadata Intelligence APIs ────────────────────────────────────────────
RAWG_API_KEY=YOUR_RAWG_KEY_HERE
TAVILY_API_KEY=YOUR_TAVILY_KEY_HERE

# ── Server Cluster Configuration (defaults shown) ─────────────────────────────
# LIBRARY_SERVER_HOST=0.0.0.0
# LIBRARY_SERVER_PORT=8800
# HEARTBEAT_TIMEOUT=45
# AI_CLASSIFY_INTERVAL=30
# NODE_SYNC_INTERVAL=300
