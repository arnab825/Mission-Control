# ── Distributed Library Server Multi-Cloud Environment ────────────────────────
# Copy to .env and fill in your values.

# ── Tier 1: Primary Master Database (Oracle Cloud VM / Self-Hosted NVMe) ──────
DATABASE_URL=postgresql://mission_control:SuperSecretSecurePassword123!@postgres:5432/mission_control?sslmode=disable
# OR connect directly to Oracle VM public IP:
# ORACLE_DATABASE_URL=postgresql://mission_control:SuperSecretSecurePassword123!@YOUR_ORACLE_IP:5432/mission_control?sslmode=require

# ── Tier 2: Cloud Hot Standby #1 (Supabase Cloud PostgreSQL) ─────────────────
SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
# Alternative variable name:
FALLBACK_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# ── Tier 3: Cloud Cold Standby #2 (Neon Serverless PostgreSQL) ────────────────
NEON_DATABASE_URL=postgresql://user:password@ep-standby-pool.neon.tech/neondb?sslmode=require
# Alternative variable name:
FALLBACK_DATABASE_URL_2=postgresql://user:password@ep-standby-pool.neon.tech/neondb?sslmode=require

# ── Tier 5: Document Mirror (MongoDB Atlas Free M0) ───────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority

# ── Redis Cache Layer ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── AI Providers for Metadata Enrichment & Auto-Classification ────────────────
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE
GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# ── Web Metadata Intelligence APIs ────────────────────────────────────────────
RAWG_API_KEY=YOUR_RAWG_KEY_HERE
TAVILY_API_KEY=YOUR_TAVILY_KEY_HERE

# ── Server Cluster Configuration (defaults shown) ─────────────────────────────
# LIBRARY_SERVER_HOST=0.0.0.0
# LIBRARY_SERVER_PORT=8800
# HEARTBEAT_TIMEOUT=45
# AI_CLASSIFY_INTERVAL=30
# NODE_SYNC_INTERVAL=300
