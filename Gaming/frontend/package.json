{
    "name":  "mission-control-frontend",
    "productName":  "Mission Control",
    "private":  true,
    "version":  "3.2.5",
    "description":  "Mission Control desktop app for gamers.",
    "author":  "Arnab Contributors \u003csupport@missioncontrol.app\u003e",
    "type":  "module",
    "main":  "dist-electron/main.cjs",
    "scripts":  {
                    "prebuild": "python ../scripts/sync_version.py",
                    "dev":  "vite",
                    "build":  "tsc -b && vite build",
                    "lint":  "eslint .",
                    "preview":  "vite preview",
                    "test":  "vitest",
                    "test:run":  "vitest run",
                    "package":  "electron-forge package",
                    "make":  "electron-forge make",
                    "make:win":  "electron-builder --win nsis --x64",
                    "make:win:all":  "electron-builder --win nsis msi zip --x64",
                    "make:linux":  "electron-builder --linux AppImage deb rpm tar.gz --x64",
                    "make:all":  "electron-builder --win --linux --x64",
                    "doctor":  "react-doctor",
                    "postinstall":  "node patch-nsis.mjs"
                },
    "devDependencies":  {
                            "@clerk/clerk-react":  "^5.61.3",
                            "@electron-forge/cli":  "^7.11.2",
                            "@electron-forge/maker-deb":  "^7.11.2",
                            "@electron-forge/maker-rpm":  "^7.11.2",
                            "@electron-forge/maker-squirrel":  "^7.11.2",
                            "@electron-forge/shared-types":  "^7.11.2",
                            "@eslint/js":  "^10.0.1",
                            "@tailwindcss/vite":  "^4.3.3",
                            "@testing-library/dom":  "^10.4.1",
                            "@testing-library/jest-dom":  "^7.0.0",
                            "@testing-library/react":  "^16.3.2",
                            "@types/node":  "^26.1.2",
                            "@types/react":  "^19.2.18",
                            "@types/react-dom":  "^19.2.4",
                            "@vitejs/plugin-react":  "^6.0.5",
                            "clsx":  "^2.1.1",
                            "electron":  "43.3.0",
                            "electron-builder":  "^26.15.3",
                            "electron-forge-maker-nsis":  "^26.15.3",
                            "electron-updater":  "^6.8.9",
                            "eslint":  "^10.8.0",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "eslint-plugin-react-refresh":  "^0.5.2",
                            "framer-motion":  "^13.0.0",
                            "fuse.js":  "^7.5.0",
                            "globals":  "^17.9.0",
                            "healthchecks":  "^1.7.3",
                            "jsdom":  "^30.0.1",
                            "lucide-react":  "^1.29.0",
                            "react":  "^19.2.8",
                            "react-doctor":  "^0.9.5",
                            "react-dom":  "^19.2.8",
                            "recharts":  "^3.10.1",
                            "tailwind-merge":  "^3.6.0",
                            "typescript":  "~7.0.2",
                            "typescript-eslint":  "^8.66.0",
                            "vite":  "^8.2.1",
                            "vite-plugin-electron":  "^1.1.1",
                            "vite-plugin-electron-renderer":  "^1.0.0",
                            "vitest":  "^4.1.7"
                        },
    "build":  {
                  "appId":  "com.missioncontrol.app",
                  "productName":  "Mission Control",
                  "compression":  "normal",
                  "publish":  {
                                  "provider":  "github",
                                  "owner":  "arnab825",
                                  "repo":  "Mission-Control"
                              },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "perMachine":  true,
                               "packElevateHelper":  true,
                               "allowElevation":  true,
                               "shortcutName":  "Mission Control",
                               "runAfterFinish":  true,
                               "createDesktopShortcut":  "always",
                               "createStartMenuShortcut":  true,
                               "license":  "electron/license.txt",
                               "include":  "electron/installer.nsh"
                           },
                  "msi":  {
                              "oneClick":  false,
                              "perMachine":  true,
                              "runAfterFinish":  true
                          },
                  "directories":  {
                                      "output":  "out/dist"
                                  },
                  "files":  [
                                "dist/**/*",
                                "dist-electron/**/*",
                                "!backend/**",
                                "!out/**"
                            ],
                  "extraResources":  [
                                         {
                                             "from":  "../backend/dist/MissionControlBackend",
                                             "to":  "MissionControlBackend"
                                         },
                                         {
                                             "from":  "app-update.yml",
                                             "to":  "app-update.yml"
                                         }
                                     ],
                  "win":  {
                              "artifactName":  "MissionControl-Setup.${ext}",
                              "icon":  "public/favicon.ico",
                              "verifyUpdateCodeSignature":  false,
                              "requestedExecutionLevel":  "requireAdministrator",
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             },
                                             {
                                                 "target":  "msi",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             },
                                             {
                                                 "target":  "zip",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ]
                          },
                  "linux":  {
                                "artifactName":  "MissionControl-Linux-${version}.${ext}",
                                "icon":  "public/logo.png",
                                "category":  "Utility",
                                "target":  [
                                               {
                                                   "target":  "AppImage",
                                                   "arch":  [
                                                                "x64"
                                                            ]
                                               },
                                               {
                                                   "target":  "deb",
                                                   "arch":  [
                                                                "x64"
                                                            ]
                                               },
                                               {
                                                   "target":  "rpm",
                                                   "arch":  [
                                                                "x64"
                                                            ]
                                               },
                                               {
                                                   "target":  "tar.gz",
                                                   "arch":  [
                                                                "x64"
                                                            ]
                                               }
                                           ]
                            }
              }
}