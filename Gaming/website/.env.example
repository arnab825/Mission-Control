# MongoDB Connection URI (e.g. mongodb://localhost:27017/mission-control)
MONGODB_URI=mongodb://localhost:27017/mission-control

# NVIDIA NIM API Key (for AI blog generation)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Hugging Face Access Token (for AI image generation)
HF_TOKEN=your_huggingface_token_here

# Google Search Console Verification Token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_token_here

# Google AdSense Publisher Client ID (e.g., ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-your_publisher_id_here

# SMTP Configuration (Nodemailer for Contact Us & Newsletter Subscription)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
CONTACT_EMAIL=support@missioncontrol.gg

