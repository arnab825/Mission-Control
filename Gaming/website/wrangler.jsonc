{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mission-control",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // To bind custom domains or subdomains in Cloudflare, either add them via
  // Cloudflare Dashboard -> Workers & Pages -> mission-control -> Settings -> Domains & Routes,
  // or define them here:
  // "routes": [
  //   { "pattern": "mission-control.rarnab225.workers.dev/*", "zone_name": "" },
  //   { "pattern": "missioncontrol.yourdomain.com/*", "custom_domain": true },
  //   { "pattern": "*.missioncontrol.yourdomain.com/*", "custom_domain": true }
  // ]
}
