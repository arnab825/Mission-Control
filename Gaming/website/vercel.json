{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/blogs/generate?batch=1",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/blogs/generate?batch=2",
      "schedule": "15 0 * * *"
    }
  ]
}
