# ═══════════════════════════════════════════════════════════════════
#  Mission Control — Master Developer Environment Configuration
#  Copy this file to .env in the root directory (or in Gaming/.env)
#  NEVER commit your actual .env file with real credentials!
# ═══════════════════════════════════════════════════════════════════

# ── AI Providers (Neural Backbone) ────────────────────────────────
NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE

# ── RAWG Game Database API ─────────────────────────────────────────
RAWG_API_KEY=YOUR_RAWG_API_KEY_HERE

# ── Database & Cloud Auth ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# ── Developer Release & WinGet Automation (For App Publishing) ─────
# Required for running .\Gaming\scripts\publish.ps1, wingetcreate submit,
# and automated PR submissions to microsoft/winget-pkgs via GitHub Actions.
# Create a classic Personal Access Token with 'public_repo' scope at:
# https://github.com/settings/tokens
WINGET_GH_TOKEN=ghp_YOUR_GITHUB_TOKEN_HERE
GH_TOKEN=ghp_YOUR_GITHUB_TOKEN_HERE
